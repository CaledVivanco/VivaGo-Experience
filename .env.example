# ═══════════════════════════════════════════════════════════
#  VIVAGO EXPERIENCE — variables de entorno (SOLO backend)
#  Copia este archivo como ".env" y coloca tus valores reales.
#  NUNCA subas el .env real a Git ni lo expongas en el frontend.
# ═══════════════════════════════════════════════════════════

# API key de OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo principal de VivaGo AI
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Modelos de respaldo separados por coma si el principal falla
# (déjalo vacío para no usar fallbacks)
OPENROUTER_FALLBACK_MODELS=

# Puerto del servidor
PORT=3000

# URL pública del sitio (se envía a OpenRouter como HTTP-Referer)
PUBLIC_SITE_URL=http://localhost:3000
